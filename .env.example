# Environment Variables Configuration Example for MarketMine AI

# Server & Application
ENV=development
APP_NAME="MarketMine AI"
SECRET_KEY=marketmine-super-secret-key-change-in-production-1234567890
API_V1_PREFIX=/api/v1
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Database Configuration
# Default: SQLite in local persistent storage
DATABASE_URL=sqlite:///./storage/marketmine.db
# MySQL option:
# DATABASE_URL=mysql+pymysql://marketmine_user:password@localhost:3306/marketmine_db

# File Storage
STORAGE_DIR=./storage
UPLOAD_DIR=./storage/uploads
ARTIFACT_DIR=./storage/artifacts
MAX_UPLOAD_SIZE_MB=50

# Generative AI Configuration
# Providers: mock | openai | anthropic | gemini | local
LLM_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
LOCAL_LLM_URL=http://localhost:11434/api/generate
DEFAULT_LLM_MODEL=gpt-4o-mini
